{
    "name": "health",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "dev:web": "cd apps/web && bun run dev",
        "dev:api": "cd apps/api && bun run dev",
        "dev:admin": "cd apps/admin && bun run dev",
        "build:web": "cd apps/web && bun run build",
        "build:admin": "cd apps/admin && bun run build",
        "build:api": "echo \"No build required\"",
        "start:api": "cd apps/api && bun run start",
        "format": "oxfmt . --write",
        "format:check": "oxfmt . --check",
        "lint": "oxlint . --deny-warnings",
        "lint:fix": "oxlint . --fix",
        "prepare": "husky"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@types/node": "^26.1.1",
        "husky": "^9.1.7",
        "oxfmt": "^0.58.0",
        "oxlint": "^1.73.0"
    },
    "engines": {
        "node": ">=22"
    }
}